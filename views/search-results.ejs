<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js"></script>
    <title>Cafe Finder - Search Results</title>
</head>

<body>
    <%- include('partials/navbar') %>

    <main class="results-main">
        <section class="search-filter-section">
            <form action="/cafes/search" method="GET" class="michelin-form">
                <div class="search-main-row">
                    <div class="search-input-wrapper">
                        <span class="search-icon">🔍</span>
                        <input type="text" name="search" placeholder="e. g. City, Cafe, Adresse..." value="<%= searchTerm %>">
                    </div>
                </div>
                <div class="filters-horizontal-row">
                    <div class="filter-badge-select">
                        <select name="tag" id="tag-select" aria-label="Filter by Cafe Features">
                            <option value="">All Features</option>
                            <option value="wifi">🛜 Fast Wi-Fi</option>
                            <option value="outlets">🔌 Power Outlets</option>
                            <option value="quiet">🤫 Quiet Environment</option>
                            <option value="tables">🪑 Big Tables</option>
                            <option value="outdoor">🌿 Outdoor Seating</option>
                            <option value="ac">❄️ Air Conditioning</option>
                            <option value="parking">🚗 Parking Available</option>
                            <option value="student_discount">🎓 Student Discount</option>
                            <option value="specialty_coffee">☕ Specialty Coffee</option>
                            <option value="snacks">🥐 Bakery & Snacks</option>
                        </select>
                    </div>
                    <button type="submit" class="filter-submit-badge">Apply & Search</button>
                </div>
            </form>
        </section>

        <div class="city-header">
            <h1>
                <% if (searchTerm) { %>
                    Results for "<span class="highlight-city"><%= searchTerm %></span>"
                <% } else { %>
                    All Cafes
                <% } %>
            </h1>
            <p class="results-count-text">Found <%= cafes.length %> cafe<%= cafes.length !== 1 ? 's' : '' %></p>
        </div>

        <section class="results-section-wrapper">
            <h2>Available Cafes</h2>

            <% if (cafes.length === 0) { %>
                <p style="color: #666; font-style: italic; text-align: center; padding: 40px 0;">
                    No cafes found matching your search. Try a different term or browse all cafes.
                </p>
            <% } else { %>
            <div class="modern-cafes-grid">
                <% cafes.forEach(cafe => { %>
                <div class="michelin-cafe-card">
                    <div class="card-image-wrapper">
                        <img src="<%= cafe.photo_url ? cafe.photo_url : '/placeholder.jpg' %>" alt="<%= cafe.name %>">
                        <button type="button" class="floating-heart-btn" aria-label="Add to Favorites">🤍</button>
                    </div>

                    <a href="/cafes/<%= cafe.id %>" class="card-info-link">
                        <div class="card-michelin-meta">
                            <span class="michelin-tag"><%= cafe.city %></span>
                        </div>
                        <h3 class="michelin-title"><%= cafe.name %></h3>
                        <p class="michelin-location"><%= cafe.city %></p>
                        <p class="michelin-address"><%= cafe.address %></p>
                    </a>
                </div>
                <% }) %>
            </div>
            <% } %>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>

</html>