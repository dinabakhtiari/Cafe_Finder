<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js"></script>
    <title>Cafe Finder - All Cafes</title>
</head>

<body>
    <%- include('partials/navbar') %>

    <main class="results-main">
        <div class="city-header">
            <h1>All Study Spots</h1>
            <p class="results-count-text">Found <%= allCafes.length %> cafes matching your search</p>
        </div>

        <section class="results-section-wrapper">
            <h2>Available Cafes</h2>

            <div class="modern-cafes-grid">
                
                <% if (allCafes && allCafes.length > 0) { %>
                    <% allCafes.forEach(cafe => { %>
                        <div class="michelin-cafe-card">
                            <div class="card-image-wrapper">
                                <img src="https://images.unsplash.com/photo-1554118811-1e0d58224f24?q=80&w=1000" alt="<%= cafe.name %> Exterior">
                                <button type="button" class="floating-heart-btn" aria-label="Add to Favorites">🤍</button>
                            </div>

                            <a href="/cafes/<%= cafe.id %>" class="card-info-link">
                                <div class="card-michelin-meta">
                                    <span class="michelin-rating">⭐ <%= cafe.rating || 'New' %></span>
                                    <span class="michelin-divider">•</span>
                                    <span class="michelin-tag">⚡ Fast Wi-Fi</span>
                                </div>
                                <h3 class="michelin-title"><%= cafe.name %></h3>
                                <p class="michelin-location"><%= cafe.city %></p>
                                <p class="michelin-address"><%= cafe.address %></p>
                            </a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p>No cafes found in the database. Be the first to add one!</p>
                <% } %>
                </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>

</html>