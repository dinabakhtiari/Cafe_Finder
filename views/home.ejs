<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js"></script>
    <title>Cafe Finder - Home</title>
</head>

<body>
    <!-- Global Header Component -->
    <%- include('partials/navbar') %>
    <main>
        <!-- Michelin-Style Search and Filter Section -->
        <section class="search-filter-section">
            <form action="/cafes/search" method="GET" class="michelin-form">

                <!-- Main Search Bar Row -->
                <div class="search-main-row">
                    <div class="search-input-wrapper">
                        <span class="search-icon">🔍</span>
                        <input type="text" name="search" placeholder="e. g. City, Cafe, Adresse...">
                    </div>
                </div>

                <!-- Horizontal Filter Badges -->
                <div class="filters-horizontal-row">
                    <button type="button" class="filter-icon-btn" aria-label="Quick Filters">Filters</button>

                    <!-- Features Select Filter -->
                    <div class="filter-badge-select">
                        <select name="tag" id="tag-select" aria-label="Filter by Cafe Features">
                            <option value="">All Features</option>
                            <option value="wifi">Fast Wi-Fi</option>
                            <option value="outlets">🔌 Power Outlets</option>
                            <option value="quiet">🤫 Quiet Environment</option>
                            <option value="tables">🪑 Big Tables</option>
                            <option value="outdoor">🌿 Outdoor Seating</option>
                            <option value="ac">❄️ Air Conditioning</option>
                            <option value="parking">🚗 Parking Available</option>
                            <option value="student-discount">🎓 Student Discount</option>
                            <option value="specialty-coffee">☕ Specialty Coffee</option>
                            <option value="snacks">🥐 Bakery & Snacks</option>
                        </select>
                    </div>

                    <button type="submit" class="filter-submit-badge">Apply & Search</button>
                </div>
            </form>
        </section>

        <hr>

        <!-- Popular Cities Navigation Section -->
        <section class="popular-cities-section">
            <h2>Explore Cafes by City</h2>
            <p>Click on a city to quickly discover its best study spots:</p>

            <div class="city-cards-container">
                <a href="/cafes/search?city=Stuttgart" class="city-card-link">
                    <div class="city-card">
                        <img src="/images/Stuttgart.webp" alt="Stuttgart Cityscape">
                        <h3>Stuttgart</h3>
                    </div>
                </a>

                <a href="/cafes/search?city=Mannheim" class="city-card-link">
                    <div class="city-card">
                        <img src="/images/mannheim.jpg" alt="Mannheim Water Tower">
                        <h3>Mannheim</h3>
                    </div>
                </a>

                <a href="/cafes/search?city=Heidelberg" class="city-card-link">
                    <div class="city-card">
                        <img src="/images/Heidelberg.jpg" alt="Heidelberg Castle and Old Bridge">
                        <h3>Heidelberg</h3>
                    </div>
                </a>

                <a href="/cafes/search?city=Frankfurt" class="city-card-link">
                    <div class="city-card">
                        <img src="/images/Frankfurt.jpg" alt="Frankfurt Skyline">
                        <h3>Frankfurt</h3>
                    </div>
                </a>

                <a href="/cafes/search?city=Munchen" class="city-card-link">
                    <div class="city-card">
                        <img src="/images/Munich.jpg" alt="München Marienplatz">
                        <h3>München</h3>
                    </div>
                </a>

                <a href="/cafes/search?city=Koblenz" class="city-card-link">
                    <div class="city-card">
                        <img src="/images/Koblenz.jpg" alt="Deutsches Eck Koblenz">
                        <h3>Koblenz</h3>
                    </div>
                </a>

                <a href="/cafes/search?city=Karlsruhe" class="city-card-link">
                    <div class="city-card">
                        <img src="/images/Karlsruhe.jpg" alt="Karlsruhe Palace">
                        <h3>Karlsruhe</h3>
                    </div>
                </a>

                <a href="/cafes/search?city=Mosbach" class="city-card-link">
                    <div class="city-card">
                        <img src="/images/Mosbach.jpg" alt="Historic Mosbach Market Square">
                        <h3>Mosbach</h3>
                    </div>
                </a>

                <a href="/cafes/search?city=Dresden" class="city-card-link">
                    <div class="city-card">
                        <img src="/images/Dresden.jpg" alt="Dresden Frauenkirche Historic Center">
                        <h3>Dresden</h3>
                    </div>
                </a>

                <a href="/cafes/search?city=Konstanz" class="city-card-link">
                    <div class="city-card">
                        <img src="/images/Konstanz.jpg" alt="Konstanz Lakefront Harbor Promenade">
                        <h3>Konstanz</h3>
                    </div>
                </a>
            </div>
        </section>

        <hr>

        <!-- Recommended Cafes Grid Section -->
        <section class="recommended-cafes-section">
            <div class="section-header-row" style="margin-bottom: 20px;">
                <h2>Recently added Cafes</h2>
            </div>

            <div class="cafes-grid">
                <!-- Cafe Card 1 -->
                <article class="cafe-card">
                    <div class="cafe-image-wrapper">
                        <img src="/placeholder.jpg" alt="Cafe interior">
                        <button type="button" class="cafe-heart-btn" onclick="toggleLikeCafe(this, 1)"
                            aria-label="Like Melu Cafe">
                            🤍
                        </button>
                    </div>
                    <h3>Melu Cafe</h3>
                    <p><strong>Location:</strong> Stuttgart</p>
                    <p>⭐ <strong>4.5</strong> / 5 (12 reviews)</p>
                    <p>A perfect place for programming and study sessions near campus.</p>
                    <p>Tags: <span>Fast Wi-Fi</span>, <span>🔌 Power Outlets</span></p>
                    <a href="/cafes/1">View Details</a>
                </article>

                <!-- Cafe Card 2 -->
                <article class="cafe-card">
                    <div class="cafe-image-wrapper">
                        <img src="/placeholder.jpg" alt="Cafe interior">
                        <button type="button" class="cafe-heart-btn" onclick="toggleLikeCafe(this, 2)"
                            aria-label="Like Paska.L Choux">
                            🤍
                        </button>
                    </div>
                    <h3>Paska.L Choux</h3>
                    <p><strong>Location:</strong> Mannheim</p>
                    <p>⭐ <strong>4.7</strong> / 5 (18 reviews)</p>
                    <p>Quiet environment with excellent French pastries and big tables.</p>
                    <p>Tags: <span>🤫 Quiet</span>, <span>🪑 Big Tables</span></p>
                    <a href="/cafes/2">View Details</a>
                </article>

                <!-- Cafe Card 3 -->
                <article class="cafe-card">
                    <div class="cafe-image-wrapper">
                        <img src="/placeholder.jpg" alt="Cafe interior">
                        <button type="button" class="cafe-heart-btn" onclick="toggleLikeCafe(this, 3)"
                            aria-label="Like Ingwer Cafe">
                            🤍
                        </button>
                    </div>
                    <h3>Ingwer Cafe</h3>
                    <p><strong>Location:</strong> Heidelberg</p>
                    <p>⭐ <strong>4.2</strong> / 5 (9 reviews)</p>
                    <p>Cozy workspace setup with bright natural light and outdoor seating.</p>
                    <p>Tags: <span>🌿 Outdoor</span>, <span>Fast Wi-Fi</span></p>
                    <a href="/cafes/3">View Details</a>
                </article>

                <!-- Cafe Card 4 -->
                <article class="cafe-card">
                    <div class="cafe-image-wrapper">
                        <img src="/placeholder.jpg" alt="Cafe interior">
                        <button type="button" class="cafe-heart-btn" onclick="toggleLikeCafe(this, 4)"
                            aria-label="Like Green Wall Coffee">
                            🤍
                        </button>
                    </div>
                    <h3>Green Wall Coffee</h3>
                    <p><strong>Location:</strong> Stuttgart</p>
                    <p>⭐ <strong>4.6</strong> / 5 (15 reviews)</p>
                    <p>Modern design covered in plants, offering student discounts.</p>
                    <p>Tags: <span>🎓 Discount</span>, <span>❄️ AC</span></p>
                    <a href="/cafes/4">View Details</a>
                </article>

                <!-- Cafe Card 5 -->
                <article class="cafe-card">
                    <div class="cafe-image-wrapper">
                        <img src="/placeholder.jpg" alt="Cafe interior">
                        <button type="button" class="cafe-heart-btn" onclick="toggleLikeCafe(this, 5)"
                            aria-label="Like Kawa Roastery">
                            🤍
                        </button>
                    </div>
                    <h3>Kawa Roastery</h3>
                    <p><strong>Location:</strong> Mannheim</p>
                    <p>⭐ <strong>4.8</strong> / 5 (22 reviews)</p>
                    <p>Specialty coffee destination with dedicated silent zones for remote work.</p>
                    <p>Tags: <span>☕ Specialty</span>, <span>🤫 Quiet</span></p>
                    <a href="/cafes/5">View Details</a>
                </article>

                <!-- Cafe Card 6 -->
                <article class="cafe-card">
                    <div class="cafe-image-wrapper">
                        <img src="/placeholder.jpg" alt="Cafe interior">
                        <button type="button" class="cafe-heart-btn" onclick="toggleLikeCafe(this, 6)"
                            aria-label="Like The Philosopher">
                            🤍
                        </button>
                    </div>
                    <h3>The Philosopher</h3>
                    <p><strong>Location:</strong> Heidelberg</p>
                    <p>⭐ <strong>4.4</strong> / 5 (14 reviews)</p>
                    <p>Spacious historic location close to the library with massive study areas.</p>
                    <p>Tags: <span>🪑 Big Tables</span>, <span>🚗 Parking</span></p>
                    <a href="/cafes/6">View Details</a>
                </article>

                <!-- Cafe Card 7 -->
                <article class="cafe-card">
                    <div class="cafe-image-wrapper">
                        <img src="/placeholder.jpg" alt="Cafe interior">
                        <button type="button" class="cafe-heart-btn" onclick="toggleLikeCafe(this, 7)"
                            aria-label="Like Urban Lab Cafe">
                            🤍
                        </button>
                    </div>
                    <h3>Urban Lab Cafe</h3>
                    <p><strong>Location:</strong> Frankfurt</p>
                    <p>⭐ <strong>4.6</strong> / 5 (8 reviews)</p>
                    <p>Industrial design workspace equipped with ultra-fast internet and standing desks.</p>
                    <p>Tags: <span>Fast Wi-Fi</span>, <span>🥐 Bakery & Snacks</span></p>
                    <a href="/cafes/7">View Details</a>
                </article>

                <!-- Cafe Card 8 -->
                <article class="cafe-card">
                    <div class="cafe-image-wrapper">
                        <img src="/placeholder.jpg" alt="Cafe interior">
                        <button type="button" class="cafe-heart-btn" onclick="toggleLikeCafe(this, 8)"
                            aria-label="Like Library Lounge">
                            🤍
                        </button>
                    </div>
                    <h3>Library Lounge</h3>
                    <p><strong>Location:</strong> Karlsruhe</p>
                    <p>⭐ <strong>4.9</strong> / 5 (31 reviews)</p>
                    <p>A premium silent study environment located right next to the city library.</p>
                    <p>Tags: <span>🤫 Quiet</span>, <span>🔌 Power Outlets</span></p>
                    <a href="/cafes/8">View Details</a>
                </article>
            </div>
        </section>
    </main>

    <!-- Unified Footer Component -->
    <%- include('partials/footer') %>
</body>

</html>