<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js"></script>
    <title>Cafe Finder - Home</title>
</head>

<body>
    <%- include('partials/navbar') %>

        <main>
            <!-- Michelin-Style Search and Filter Section -->
            <section class="search-filter-section">
                <form action="/cafes/search" method="GET" class="michelin-form">

                    <!-- Main Search Bar Row -->
                    <div class="search-main-row">
                        <div class="search-input-wrapper">
                            <span class="search-icon">🔍</span>
                            <input type="text" name="search" placeholder="e. g. City, Cafe, Adresse...">
                        </div>
                    </div>

                    <!-- Horizontal Filter Badges -->
                    <div class="filters-horizontal-row">

                        <!-- Features Select Filter -->
                        <div class="filter-badge-select">
                            <select name="tag" id="tag-select" aria-label="Filter by Cafe Features">
                                <option value="">All Features</option>
                                <option value="wifi">🛜 Fast Wi-Fi</option>
                                <option value="outlets">🔌 Power Outlets</option>
                                <option value="quiet">🤫 Quiet Environment</option>
                                <option value="tables">🪑 Big Tables</option>
                                <option value="outdoor">🌿 Outdoor Seating</option>
                                <option value="ac">❄️ Air Conditioning</option>
                                <option value="parking">🚗 Parking Available</option>
                                <option value="student_discount">🎓 Student Discount</option>
                                <option value="specialty_coffee">☕ Specialty Coffee</option>
                                <option value="snacks">🥐 Bakery & Snacks</option>
                            </select>
                        </div>

                        <button type="submit" class="filter-submit-badge">Apply & Search</button>
                    </div>
                </form>
            </section>

            <hr>

            <!-- Popular Cities Navigation Section -->
            <section class="popular-cities-section">
                <h2>Explore Cafes by City</h2>
                <p>Click on a city to quickly discover its best study spots:</p>

                <div class="city-cards-container">
                    <a href="/cafes/search?city=Stuttgart" class="city-card-link">
                        <div class="city-card">
                            <img src="../public/images/Stuttgart.webp" alt="Stuttgart Cityscape">
                            <h3>Stuttgart</h3>
                        </div>
                    </a>

                    <a href="/cafes/search?city=Mannheim" class="city-card-link">
                        <div class="city-card">
                            <img src="../public/images/mannheim.jpg" alt="Mannheim Water Tower">
                            <h3>Mannheim</h3>
                        </div>
                    </a>

                    <a href="/cafes/search?city=Heidelberg" class="city-card-link">
                        <div class="city-card">
                            <img src="../public/images/Heidelberg.jpg" alt="Heidelberg Castle and Old Bridge">
                            <h3>Heidelberg</h3>
                        </div>
                    </a>

                    <a href="/cafes/search?city=Frankfurt" class="city-card-link">
                        <div class="city-card">
                            <img src="../public/images/Frankfurt.jpg" alt="Frankfurt Skyline">
                            <h3>Frankfurt</h3>
                        </div>
                    </a>

                    <a href="/cafes/search?city=Munchen" class="city-card-link">
                        <div class="city-card">
                            <img src="../public/images/Munich.jpg" alt="München Marienplatz">
                            <h3>München</h3>
                        </div>
                    </a>

                    <a href="/cafes/search?city=Koblenz" class="city-card-link">
                        <div class="city-card">
                            <img src="../public/images/Koblenz.jpg" alt="Deutsches Eck Koblenz">
                            <h3>Koblenz</h3>
                        </div>
                    </a>

                    <a href="/cafes/search?city=Karlsruhe" class="city-card-link">
                        <div class="city-card">
                            <img src="../public/images/Karlsruhe.jpg" alt="Karlsruhe Palace">
                            <h3>Karlsruhe</h3>
                        </div>
                    </a>

                    <a href="/cafes/search?city=Mosbach" class="city-card-link">
                        <div class="city-card">
                            <img src="../public/images/Mosbach.jpg" alt="Historic Mosbach Market Square">
                            <h3>Mosbach</h3>
                        </div>
                    </a>

                    <!-- City Card 9 (New Spot) -->
                    <a href="/cafes/search?city=Dresden" class="city-card-link">
                        <div class="city-card">
                            <img src="../public/images/Dresden.jpg" alt="Dresden Frauenkirche Historic Center">
                            <h3>Dresden</h3>
                        </div>
                    </a>

                    <!-- City Card 10 (New Spot) -->
                    <a href="/cafes/search?city=Konstanz" class="city-card-link">
                        <div class="city-card">
                            <img src="../public/images/Konstanz.jpg" alt="Konstanz Lakefront Harbor Promenade">
                            <h3>Konstanz</h3>
                        </div>
                    </a>
                </div>
            </section>

            <hr>

            <!-- Recommended Cafes Grid Section -->
            <section class="recommended-cafes-section">
                <div class="section-header-row" style="margin-bottom: 20px;">
                    <h2>Recently added Cafes</h2>
                </div>

                <% if (recentCafes.length===0) { %>
                    <p style="color: #666; font-style: italic; text-align: center; padding: 40px 0;">
                        No cafes added yet. Be the first to <a href="/user-profile">add one</a>!
                    </p>
                    <% } else { %>
                        <div class="cafes-grid">
                            <% recentCafes.forEach(cafe=> { %>
                                <article class="cafe-card">
                                    <div class="cafe-image-wrapper">
                                        <img src="<%= cafe.photo_url ? cafe.photo_url : '/placeholder.jpg' %>"
                                            alt="<%= cafe.name %>">
                                    </div>
                                    <h3>
                                        <%= cafe.name %>
                                    </h3>
                                    <p><strong>Location:</strong>
                                        <%= cafe.city %>
                                    </p>
                                    <p>
                                        <%= cafe.description || '' %>
                                    </p>
                                    <a href="/cafes/<%= cafe.id %>">View Details</a>
                                </article>
                                <% }) %>
                        </div>
                        <% } %>
            </section>
        </main>

        <%- include('partials/footer') %>
</body>

</html>
