<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js"></script>
    <title>Cafe Finder - User Profile</title>
</head>

<body>
    <%- include('partials/navbar') %>

    <main class="profile-main-container">

        <header class="user-profile-bio-header">
            <div class="bio-avatar-wrapper">
                <img src="/placeholder-avatar.jpg" alt="Profile picture" class="profile-avatar-large">
            </div>

            <div class="bio-info-details">
                <div class="meta-field-row">
                    <span class="field-label">Name:</span>
                    <span class="field-value user-important-name"><%= user.name %></span>
                </div>
                <div class="meta-field-row">
                    <span class="field-label">Username:</span>
                    <span class="field-value">@<%= user.username %></span>
                </div>
                <div class="meta-field-row">
                    <span class="field-label">Email:</span>
                    <span class="field-value"><%= user.email %></span>
                </div>
            </div>

            <div class="bio-action-corner">
                <a href="/profile/edit" class="profile-edit-link">Edit 📝</a>
            </div>
        </header>

        <div class="profile-bottom-content">

            <section class="profile-data-card contributed-cafes-section">
                <div class="contributed-header-row">
                    <h3>My Contributed Cafes</h3>
                    <button type="button" class="filter-submit-badge add-cafe-toggle-btn" onclick="toggleAddCafeForm()">➕ Add a New Cafe</button>
                </div>

                <div id="inline-add-cafe-container" class="inline-form-wrapper">
                    <h4 class="form-inner-title">Enter Cafe Details</h4>
                    <form action="/cafes" method="POST" enctype="multipart/form-data" class="review-form">
                        <div class="form-group">
                            <label for="cafe-title" class="form-field-label">Cafe Name:</label>
                            <input type="text" id="cafe-title" name="name" placeholder="e.g. Melu Cafe" required
                                class="form-text-input">
                        </div>

                        <div class="form-row-flex">
                            <div class="form-group flex-1">
                                <label for="cafe-city" class="form-field-label">City:</label>
                                <input type="text" id="cafe-city" name="city" placeholder="e.g. Stuttgart" required class="form-text-input">
                            </div>
                            <div class="form-group flex-2">
                                <label for="cafe-address" class="form-field-label">Full Address:</label>
                                <input type="text" id="cafe-address" name="address" placeholder="e.g. Theodor-Heuss-Straße 26" required class="form-text-input">
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="cafe-image" class="form-field-label">Cafe Cover Photo:</label>
                            <input type="file" id="cafe-image" name="photo" accept="image/*" required class="form-file-input">
                        </div>

                        <div class="cafe-features-selection">
                            <p class="features-tip">Select all available features that apply to this location:</p>
                            <div class="tags-flex-container">
                                <label class="tag-checkbox-label"><input type="checkbox" name="tags" value="wifi"><span>⚡ Fast Wi-Fi</span></label>
                                <label class="tag-checkbox-label"><input type="checkbox" name="tags" value="outlets"><span>🔌 Power Outlets</span></label>
                                <label class="tag-checkbox-label"><input type="checkbox" name="tags" value="quiet"><span>🤫 Quiet Environment</span></label>
                                <label class="tag-checkbox-label"><input type="checkbox" name="tags" value="tables"><span>🪑 Big Tables</span></label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="cafe-description" class="form-field-label">Short Description:</label>
                            <textarea id="cafe-description" name="description" rows="3"
                                placeholder="Describe the study environment..." required
                                class="form-textarea-input"></textarea>
                        </div>

                        <div class="form-actions-flex">
                            <button type="button" class="action-delete-btn cancel-form-btn"
                                onclick="toggleAddCafeForm()">Cancel</button>
                            <button type="submit" class="review-submit-btn submit-form-btn">Publish Cafe ☕</button>
                        </div>
                    </form>
                    <hr class="form-divider">
                </div>

                <ul class="profile-list">
                    <% if (contributedCafes.length === 0) { %>
                        <li class="profile-list-item" style="color: #888; font-style: italic;">You haven't added any cafes yet.</li>
                    <% } else { %>
                        <% contributedCafes.forEach(cafe => { %>
                        <li class="profile-list-item">
                            <span class="item-details"><strong><%= cafe.name %></strong> - <%= cafe.city %> (<%= cafe.address %>)</span>
                            <div class="item-actions">
                                <a href="/cafes/<%= cafe.id %>" class="action-view-btn">View</a>
                                <button type="button" class="action-view-btn" onclick="toggleEditCafeForm('<%= cafe.id %>')">Edit 📝</button>
                                <button type="button" class="action-delete-btn" onclick="deleteCafe(<%= cafe.id %>)">Delete</button>
                            </div>
                        </li>

                        <div id="inline-edit-cafe-<%= cafe.id %>" class="inline-form-wrapper auth-card id-hidden"
                            style="max-width: 100%; margin-top: 15px; border-inline-start: 4px solid #6f4e37;">
                            <h4 class="form-inner-title" style="color: #6f4e37;">Edit Cafe Details: <%= cafe.name %></h4>
                            <form id="edit-cafe-form-<%= cafe.id %>" action="/cafes/<%= cafe.id %>" method="POST" enctype="multipart/form-data"
                                class="review-form" onsubmit="submitEditCafeForm(event, '<%= cafe.id %>')"
                                style="background-color: transparent; border: none; padding: 0; box-shadow: none;">
                                <div class="form-group">
                                    <label class="form-field-label">Cafe Name:</label>
                                    <input type="text" name="name" value="<%= cafe.name %>" required class="form-text-input">
                                </div>
                                <div class="form-row-flex">
                                    <div class="form-group flex-1">
                                        <label class="form-field-label">City:</label>
                                        <input type="text" name="city" value="<%= cafe.city %>" required class="form-text-input">
                                    </div>
                                    <div class="form-group flex-2">
                                        <label class="form-field-label">Full Address:</label>
                                        <input type="text" name="address" value="<%= cafe.address %>" required class="form-text-input">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="form-field-label">Change Cover Photo (Optional):</label>
                                    <input type="file" name="photo" accept="image/*" class="form-file-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-field-label">Short Description:</label>
                                    <textarea name="description" rows="3" required class="form-textarea-input"><%= cafe.description %></textarea>
                                </div>
                                <div class="form-actions-flex">
                                    <button type="button" class="action-delete-btn cancel-form-btn"
                                        onclick="toggleEditCafeForm('<%= cafe.id %>')">Cancel</button>
                                    <button type="submit" class="review-submit-btn submit-form-btn"
                                        style="background-color: #2b8a3e;">Save Changes 💾</button>
                                </div>
                            </form>
                            <hr class="form-divider">
                        </div>
                        <% }) %>
                    <% } %>
                </ul>
            </section>

            <section class="profile-data-card">
                <h3>My Comments & Reviews</h3>
                <ul class="profile-list">
                    <% if (userReviews.length === 0) { %>
                        <li class="profile-list-item" style="color: #888; font-style: italic;">You haven't written any reviews yet.</li>
                    <% } else { %>
                        <% userReviews.forEach(review => { %>
                        <li class="profile-list-item">
                            <span class="item-details">
                                Reviewed <a href="/cafes/<%= review.cafe_id %>"><strong><%= review.cafe_name %></strong></a>:
                                "<%= review.comment %>"
                                <span class="review-score-badge"><%= review.rating %>/5 ⭐</span>
                            </span>
                            <div class="item-actions">
                                <button type="button" class="action-delete-btn" onclick="deleteReview(<%= review.id %>)">Delete</button>
                            </div>
                        </li>
                        <% }) %>
                    <% } %>
                </ul>
            </section>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>

</html>