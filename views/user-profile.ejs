<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js"></script>
    <title>Cafe Finder - User Profile</title>
</head>

<body>
    <header>
        <div class="header-container">
            <div class="logo">
                <a href="/">☕ Cafe Finder</a>
            </div>

            <nav>
                <ul class="nav-links">
                    <li><a href="/">Home</a></li>
                    <li><a href="/about-us">About Us</a></li>
                </ul>

                <div class="profile-menu-container">
                    <button type="button" class="profile-menu-btn" onclick="toggleProfileDropdown()"
                        aria-label="Toggle profile menu">
                        <span class="profile-avatar-icon">👤</span>
                        <span class="hamburger-lines-icon">☰</span>
                    </button>

                    <div class="profile-dropdown" id="profileDropdown">
                        <ul>
                            <% if (typeof user !== 'undefined' && user) { %>
                            <!-- Display these navigation links only to authenticated users -->
                                <li><a href="/user-profile">👤 Profile</a></li>
                                <li><a href="/my-comments">💬 My Comments</a></li>
                                <li><a href="/saved-cafes">❤️ Saved Cafes</a></li>
                                <li class="dropdown-divider"></li>
                                <li><a href="/auth/logout" class="logout-link">🚪 Logout</a></li>
                            <% } else { %>
                            <!-- Display this link only to guests/unauthenticated users -->
                                <li><a href="/login-register">🔑 Login / Register</a></li>
                            <% } %>
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="profile-main-container">

        <header class="user-profile-bio-header">
            <div class="bio-avatar-wrapper">
                <img src="avatar.jpg" alt="Dina's profile picture" class="profile-avatar-large">
            </div>

            <div class="bio-info-details">
                <div class="meta-field-row">
                    <span class="field-label">Name:</span>
                    <span class="field-value user-important-name">Dina Bakhtiari</span>
                </div>
                <div class="meta-field-row">
                    <span class="field-label">Username:</span>
                    <span class="field-value">@dina_b</span>
                </div>
                <div class="meta-field-row">
                    <span class="field-label">Email:</span>
                    <span class="field-value">dina.bakhtiari@example.com</span>
                </div>
                <div class="meta-field-row">
                    <span class="field-label">Bio:</span>
                    <span class="field-value bio-text-multiline">Computer Science Student | Passionate about discovering
                        quiet study spots and productive workspaces.</span>
                </div>
            </div>

            <div class="bio-action-corner">
                <a href="/profile/edit" class="profile-edit-link">Edit 📝</a>
            </div>
        </header>

        <div class="profile-bottom-content">

            <section class="profile-data-card contributed-cafes-section">
                <div class="contributed-header-row">
                    <h3>My Contributed Cafes</h3>
                    <button type="button" class="filter-submit-badge add-cafe-toggle-btn"
                        onclick="toggleAddCafeForm()">➕ Add a New Cafe</button>
                </div>

                <div id="inline-add-cafe-container" class="inline-form-wrapper">
                    <h4 class="form-inner-title">Enter Cafe Details</h4>
                    <form action="/cafes" method="POST" enctype="multipart/form-data" class="review-form">
                        <div class="form-group">
                            <label for="cafe-title" class="form-field-label">Cafe Name:</label>
                            <input type="text" id="cafe-title" name="name" placeholder="e.g. Melu Cafe" required
                                class="form-text-input">
                        </div>

                        <div class="form-row-flex">
                            <div class="form-group flex-1">
                                <label for="cafe-city" class="form-field-label">City:</label>
                                <input type="text" id="cafe-city" name="city" placeholder="e.g. Stuttgart" required
                                    class="form-text-input">
                            </div>
                            <div class="form-group flex-2">
                                <label for="cafe-address" class="form-field-label">Full Address:</label>
                                <input type="text" id="cafe-address" name="address"
                                    placeholder="e.g. Theodor-Heuss-Straße 26" required class="form-text-input">
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="cafe-image" class="form-field-label">Cafe Cover Photo:</label>
                            <input type="file" id="cafe-image" name="photo" accept="image/*" required
                                class="form-file-input">
                        </div>

                        <div class="cafe-features-selection">
                            <p class="features-tip">Select all available features that apply to this location:</p>
                            <div class="tags-flex-container">
                                <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                        value="wifi"><span>Fast Wi-Fi</span></label>
                                <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                        value="outlets"><span>🔌 Power Outlets</span></label>
                                <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                        value="quiet"><span>🤫 Quiet Environment</span></label>
                                <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                        value="tables"><span>🪑 Big Tables</span></label>
                                <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                        value="outdoor"><span>🌿 Outdoor Seating</span></label>
                                <label class="tag-checkbox-label"><input type="checkbox" name="tags" value="ac"><span>❄️
                                        Air Conditioning</span></label>
                                <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                        value="parking"><span>🚗 Parking Available</span></label>
                                <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                        value="student-discount"><span>🎓 Student Discount</span></label>
                                <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                        value="specialty-coffee"><span>☕ Specialty Coffee</span></label>
                                <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                        value="snacks"><span>🥐 Bakery & Snacks</span></label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="cafe-description" class="form-field-label">Short Description:</label>
                            <textarea id="cafe-description" name="description" rows="3"
                                placeholder="Describe the study environment..." required
                                class="form-textarea-input"></textarea>
                        </div>

                        <div class="form-actions-flex">
                            <button type="button" class="action-delete-btn cancel-form-btn"
                                onclick="toggleAddCafeForm()">Cancel</button>
                            <button type="submit" class="review-submit-btn submit-form-btn">Publish Cafe ☕</button>
                        </div>
                    </form>
                    <hr class="form-divider">
                </div>

                <ul class="profile-list">
                    <li class="profile-list-item">
                        <span class="item-details"><strong>Melu Cafe</strong> - Stuttgart (Theodor-Heuss-Straße
                            26)</span>
                        <div class="item-actions">
                            <button type="button" class="action-view-btn" onclick="toggleEditCafeForm('1')">Edit
                                📝</button>
                            <form action="/cafes/1/delete" method="POST" class="inline-form"
                                onsubmit="return confirm('Are you sure you want to delete this cafe permanently?');">
                                <button type="submit" class="action-delete-btn">Delete</button>
                            </form>
                        </div>
                    </li>

                    <div id="inline-edit-cafe-1" class="inline-form-wrapper auth-card id-hidden"
                        style="max-width: 100%; margin-top: 15px; border-inline-start: 4px solid #6f4e37;">
                        <h4 class="form-inner-title" style="color: #6f4e37;">Edit Cafe Details: Melu Cafe</h4>
                        <form id="edit-cafe-form-1" action="/cafes/1" method="POST" enctype="multipart/form-data"
                            class="review-form" onsubmit="submitEditCafeForm(event, '1')"
                            style="background-color: transparent; border: none; padding: 0; box-shadow: none;">
                            <div class="form-group">
                                <label for="edit-title-1" class="form-field-label">Cafe Name:</label>
                                <input type="text" id="edit-title-1" name="title" value="Melu Cafe" required
                                    class="form-text-input">
                            </div>

                            <div class="form-row-flex">
                                <div class="form-group flex-1">
                                    <label for="edit-city-1" class="form-field-label">City:</label>
                                    <input type="text" id="edit-city-1" name="city" value="Stuttgart" required
                                        class="form-text-input">
                                </div>
                                <div class="form-group flex-2">
                                    <label for="edit-address-1" class="form-field-label">Full Address:</label>
                                    <input type="text" id="edit-address-1" name="address"
                                        value="Theodor-Heuss-Straße 26" required class="form-text-input">
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="edit-image-1" class="form-field-label">Change Cover Photo
                                    (Optional):</label>
                                <input type="file" id="edit-image-1" name="photo" accept="image/*"
                                    class="form-file-input">
                            </div>

                            <div class="cafe-features-selection">
                                <p class="features-tip">Update available features for this location:</p>
                                <div class="tags-flex-container">
                                    <label class="tag-checkbox-label"><input type="checkbox" name="tags" value="wifi"
                                            checked><span>Fast Wi-Fi</span></label>
                                    <label class="tag-checkbox-label"><input type="checkbox" name="tags" value="outlets"
                                            checked><span>🔌 Power Outlets</span></label>
                                    <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                            value="quiet"><span>🤫 Quiet Environment</span></label>
                                    <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                            value="tables"><span>🪑 Big Tables</span></label>
                                    <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                            value="outdoor"><span>🌿 Outdoor Seating</span></label>
                                    <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                            value="ac"><span>❄️ Air Conditioning</span></label>
                                    <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                            value="parking"><span>🚗 Parking Available</span></label>
                                    <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                            value="student-discount"><span>🎓 Student Discount</span></label>
                                    <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                            value="specialty-coffee"><span>☕ Specialty Coffee</span></label>
                                    <label class="tag-checkbox-label"><input type="checkbox" name="tags"
                                            value="snacks"><span>🥐 Bakery & Snacks</span></label>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="edit-description-1" class="form-field-label">Short Description:</label>
                                <textarea id="edit-description-1" name="description" rows="3" required
                                    class="form-textarea-input">A perfect place for programming and study sessions near
                                    campus.</textarea>
                            </div>

                            <div class="form-actions-flex">
                                <button type="button" class="action-delete-btn cancel-form-btn"
                                    onclick="toggleEditCafeForm('1')">Cancel</button>
                                <button type="submit" class="review-submit-btn submit-form-btn"
                                    style="background-color: #2b8a3e;">Save Changes 💾</button>
                            </div>
                        </form>
                        <hr class="form-divider">
                    </div>
                </ul>
            </section>

            <section class="profile-data-card">
                <h3>My Comments & Reviews</h3>
                <ul class="profile-list">
                    <li class="profile-list-item">
                        <span class="item-details">Commented on <strong>Melu Cafe</strong>: "Loved the atmosphere!
                            Definitely coming back next week." <span class="review-score-badge">5/5 ⭐</span></span>
                        <div class="item-actions">
                            <form action="/comments/1/delete" method="POST" class="inline-form">
                                <button type="submit" class="action-delete-btn">Delete</button>
                            </form>
                        </div>
                    </li>
                </ul>
            </section>

        </div>
    </main>

    <footer class="cafe-details-footer">
        <p>&copy; 2026 Cafe Finder. All rights reserved.</p>
        <p>
            <a href="/about-us">About Us & Contact</a> |
            <a href="/">Home</a>
        </p>

        <div>
            <a href="https://instagram.com" class="footer-link" target="_blank" rel="noopener">Instagram</a>
            <a href="https://x.com" class="footer-link" target="_blank" rel="noopener">Twitter / X</a>
            <a href="https://facebook.com" class="footer-link" target="_blank" rel="noopener">Facebook</a>
        </div>
    </footer>
</body>

</html>