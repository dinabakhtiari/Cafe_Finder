<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js"></script>
    <title>Cafe Finder - Saved Cafes</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="results-main">
        <div class="city-header">
            <h1>My <span class="highlight-city">Saved Cafes</span></h1>
            <p class="results-count-text">Your curated list of favorite remote work and study spots.</p>
        </div>

        <section class="results-section-wrapper">
            <!-- Grid Layout optimized automatically via style.css -->
            <div class="modern-cafes-grid">
                
                <!-- Saved Cafe Item 1 -->
                <article class="michelin-cafe-card" id="saved-cafe-2">
                    <div class="card-image-wrapper">
                        <img src="placeholder.jpg" alt="Interior of Schloss Cafe">
                        <!-- Modern AJAX handler to remove bookmarks with confirmation -->
                        <button type="button" class="floating-heart-btn" onclick="removeBookmark(2)" aria-label="Remove Schloss Cafe from favorites">
                            ❤️
                        </button>
                    </div>
                    
                    <a href="/cafes/2" class="card-info-link">
                        <div class="card-michelin-meta">
                            <span class="michelin-rating">⭐ 4.7</span>
                            <span class="michelin-divider">|</span>
                            <span class="michelin-tag">Stuttgart</span>
                        </div>
                        <h3 class="michelin-title">Schloss Cafe</h3>
                        <p class="michelin-location">Königstraße 18, Stuttgart</p>
                    </a>
                </article>

            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>