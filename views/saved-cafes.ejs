<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js"></script>
    <title>Cafe Finder - Saved Cafes</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="results-main">
        <div class="city-header">
            <h1>My <span class="highlight-city">Saved Cafes</span></h1>
            <p class="results-count-text">Your curated list of favorite remote work and study spots.</p>
        </div>

        <section class="results-section-wrapper">
            <div class="modern-cafes-grid">
                
                <% if (typeof savedCafes !== 'undefined' && savedCafes.length > 0) { %>
                    <!-- Loop through all the user's saved cafes from the database -->
                    <% savedCafes.forEach(cafe => { %>
                        <article class="michelin-cafe-card" id="saved-cafe-<%= cafe.id %>">
                            <div class="card-image-wrapper">
                                <!-- Dynamically load the cafe image or a placeholder -->
                                <img src="<%= cafe.photo_url ? cafe.photo_url : '/placeholder.jpg' %>" alt="Interior of <%= cafe.name %>">
                                
                                <button type="button" class="floating-heart-btn" onclick="removeBookmark(<%= cafe.id %>)" aria-label="Remove <%= cafe.name %> from favorites">
                                    ❤️
                                </button>
                            </div>
                            
                            <a href="/cafes/<%= cafe.id %>" class="card-info-link">
                                <div class="card-michelin-meta">
                                    <span class="michelin-rating">⭐ <%= cafe.rating || 'New' %></span>
                                    <span class="michelin-divider">|</span>
                                    <span class="michelin-tag"><%= cafe.city %></span>
                                </div>
                                <h3 class="michelin-title"><%= cafe.name %></h3>
                                <p class="michelin-location"><%= cafe.address %>, <%= cafe.city %></p>
                            </a>
                        </article>
                    <% }) %>
                <% } else { %>
                    <!-- What to show if the user hasn't saved any cafes yet -->
                    <div class="no-results-message" style="text-align: center; grid-column: 1 / -1; padding: 40px;">
                        <h3>You haven't saved any cafes yet!</h3>
                        <p>Go explore some cafes and click the heart icon to save them here.</p>
                        <br>
                        <a href="/" class="auth-submit-btn" style="display: inline-block; text-decoration: none; max-width: 200px;">Explore Cafes</a>
                    </div>
                <% } %>

            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>